# Copy this file to .env and adjust as needed. Every value has a sane
# default baked into liquidity_depth/config.py, so an empty/missing .env
# is fine - this file only needs to be edited to override something.

# --- RPC ---------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com

# --- Verified contracts (only override if Uniswap redeploys) -----------
# UNISWAP_V3_FACTORY=0x1f7d7550b1B028F7571E69a784071F0205Fd2EfA
# UNISWAP_V4_POOL_MANAGER=0x8366A39CC670B4001A1121b8f6A443A643E40951

# --- Verified quote tokens ----------------------------------------------
# WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# NVDA_ADDRESS=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC

# Comma-separated list of tokens to check the target token against when
# discovering pools. Defaults to WETH,USDG,NVDA if unset. If you add a
# token here, also add a USD price source for it in liquidity_depth/tokens.py
# (see _EXTERNAL_PRICE_FEEDS / _STABLECOIN_PRICES) or its pools will be
# skipped from USD aggregation.
# QUOTE_TOKENS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73,0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168,0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC

# --- Token to analyze when none is passed on the CLI --------------------
# DEFAULT_TOKEN=0x2e8C31162B855a2fFa90F6F8634643aD6F111E18

# --- Depth chart parameters ----------------------------------------------
# DEFAULT_WINDOW_PCT=0.5
# Unset = pick the number of chart bars automatically per token (40-200).
# DEFAULT_NUM_BINS=200
# AUTO_BINS_MIN=40
# AUTO_BINS_MAX=200
# MAX_V4_POOLS=15

# --- RPC performance tuning ----------------------------------------------
# See docs/METHODOLOGY.md "Performance notes" for how these were measured against the
# public RPC.
# RPC_CONCURRENCY=6
# RPC_BATCH_SIZE=35
# MULTICALL_CHUNK_SIZE=500
# Leave empty to disable Multicall3 and use plain JSON-RPC batching only.
# MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
# RPC_TIMEOUT_SECONDS=30

# --- Independent price cross-check (see docs/METHODOLOGY.md "Price cross-check") ------
# DEXSCREENER_CHAIN_ID=robinhood
# PRICE_CHECK_THRESHOLD_PCT=10

# --- Web UI result cache --------------------------------------------------
# WEB_RESULT_CACHE_TTL_SECONDS=45
